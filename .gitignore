# --- OS ---
.DS_Store
Thumbs.db

# --- Editors ---
.vscode/
.idea/
*.swp

# --- Node ---
node_modules/
npm-debug.log*
pnpm-debug.log*
yarn-error.log*
dist/
build/
.next/

# --- Test artifacts (generated; thresholds are enforced in CI, not committed) ---
coverage/
*.lcov
.vitest/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/

# --- Secrets: never commit credentials (see docs/05-guardrails-governance.md) ---
.env
.env.*
!.env.example
*.pem
*.key
secrets.yaml
app-config.local.yaml

# Local key material handed over out-of-band. These belong in GitHub Secrets,
# never in the repo: docs/05 §3.3 forbids credentials from reaching the agent's
# context, and anything committed here would ride along in every clone.
docs/claude-key
**/claude-key
*-key
*_key
!config/github/*.json

# --- Factory runtime artifacts ---
.factory/runs/
*.run.log

# Factory runtime artifacts (agent report, run state)
.factory/
_apalache-out/

# Backstage 本機 dev 橋接（見 backstage/plugins/README.md wiring）
backstage/plugins/node_modules
