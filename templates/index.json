            "gates": [
              "HG4",
              "HG6"
            ]
          },
          {
            "id": "S8",
            "phase": "P3",
            "action": "依 A2 清單補測試（每模組／檔案 1 張）",
            "kind": "work-item",
            "task_type": "agent-add-tests",
            "per": "module",
            "gates": [
              "HG3"
            ]
          },
          {
            "id": "S9",
            "phase": "P3",
            "action": "修復揭露的缺陷（每個缺陷 1 張）",
            "kind": "work-item",
            "task_type": "agent-fix-bug",
            "per": "defect",
            "conditional": true,
            "gates": [
              "HG3"
            ]
          },
          {
            "id": "S10",
            "phase": "P3",
            "action": "驗證閘門（每核心模組擇一）",
            "kind": "work-item",
            "per": "module",
            "alternatives": [
              {
                "kind": "work-item",
                "action": "Quint 可執行規格",
                "task_type": "agent-write-spec"
              },
              {
                "kind": "work-item",
                "action": "Hegel 性質測試稽核",
                "task_type": "agent-pbt-audit"
              },
              {
                "kind": "human",
                "action": "豁免單（HG5 簽核）"
              }
            ],
            "gates": [
              "HG5",
              "HG6"
            ]
          },
          {
            "id": "S11",
            "phase": "P4",
            "action": "維護（依需要）",
            "kind": "work-item",
            "required": false,
            "alternatives": [
              {
                "kind": "work-item",
                "action": "升級相依",
                "task_type": "agent-update-deps"
              },
              {
                "kind": "work-item",
                "action": "修復缺陷",
                "task_type": "agent-fix-bug"
              },
              {
                "kind": "work-item",
                "action": "提出技能草案",
                "task_type": "agent-propose-skill"
              }
            ],
            "gates": [
              "HG0",
              "HG3"
            ]
          }
        ]
      }
    },
