{
  "name": "software-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Automated software factory: Backstage IDP + DeepSeek Harness + GitHub stacked PRs",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run src",
    "test:integration": "vitest run test/integration",
    "test:adversarial": "vitest run test/adversarial",
    "test:e2e": "vitest run test/e2e",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "@informalsystems/quint": "0.32.0",
    "@types/node": "26.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "js-yaml": "5.4.0",
    "minimatch": "10.2.6",
    "zod": "4.4.3"
  },
  "overrides": {
    "adm-zip": "0.6.0"
  }
}
